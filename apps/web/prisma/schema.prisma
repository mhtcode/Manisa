generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum Locale {
  en
  fa
}

enum Theme {
  DARK
  LIGHT
  SYSTEM
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  HISTORICAL
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String
  role                Role                 @default(ADMIN)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  settings            Settings?
  instagramConnection InstagramConnection?
}

model Settings {
  id                String   @id @default(cuid())
  userId            String   @unique
  businessName      String   @default("Manisa")
  locale            Locale   @default(en)
  theme             Theme    @default(DARK)
  currency          String   @default("CAD") @db.VarChar(3)
  timezone          String   @default("America/Toronto")
  mobileNavOrder    String   @default("report,calendar,gallery,settings")
  collectionViews   Json     @default("{}")
  collapsedSections Json     @default("{}")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Customer {
  id                String        @id @default(cuid())
  firstName         String
  lastName          String?
  displayName       String?
  phone             String?
  email             String?
  address           String?
  notes             String?
  preferredLanguage Locale        @default(en)
  active            Boolean       @default(true)
  appointments      Appointment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([firstName, lastName])
  @@index([phone])
  @@index([email])
  @@index([active])
  @@index([createdAt])
}

model StudioCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String    @default("sparkles")
  accentColor String    @default("#4F8CFF") @db.VarChar(7)
  position    Int       @default(0)
  active      Boolean   @default(true)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, position])
}

model Service {
  id                        String                     @id @default(cuid())
  name                      String
  description               String?
  defaultDurationMinutes    Int
  defaultPrice              Decimal                    @db.Decimal(12, 2)
  currency                  String                     @default("CAD") @db.VarChar(3)
  categoryId                String
  category                  StudioCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supportsColor             Boolean                    @default(false)
  active                    Boolean                    @default(true)
  appointments              Appointment[]
  appointmentServices       AppointmentService[]
  actualAppointmentServices AppointmentActualService[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([name])
  @@index([active])
  @@index([categoryId, active])
}

model Appointment {
  id                      String                     @id @default(cuid())
  customerId              String
  serviceId               String
  customer                Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service                 Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceLines            AppointmentService[]
  actualServiceLines      AppointmentActualService[]
  photos                  AppointmentPhoto[]
  serviceNameSnapshot     String
  startAt                 DateTime                   @db.Timestamptz(3)
  expectedDurationMinutes Int
  actualDurationMinutes   Int?
  status                  AppointmentStatus          @default(SCHEDULED)
  expectedPrice           Decimal                    @db.Decimal(12, 2)
  finalPrice              Decimal?                   @db.Decimal(12, 2)
  currency                String                     @default("CAD") @db.VarChar(3)
  paymentStatus           PaymentStatus              @default(UNPAID)
  notes                   String?
  completionNotes         String?
  calendarEventId         String?                    @unique
  calendarSyncError       String?
  completedAt             DateTime?                  @db.Timestamptz(3)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([startAt])
  @@index([customerId, startAt])
  @@index([serviceId, startAt])
  @@index([status, startAt])
  @@index([status, completedAt])
  @@index([paymentStatus])
}

model AppointmentService {
  id                  String      @id @default(cuid())
  appointmentId       String
  serviceId           String
  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service             Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceNameSnapshot String
  durationMinutes     Int
  price               Decimal     @db.Decimal(12, 2)
  selectedColor       String?
  position            Int         @default(0)
  createdAt           DateTime    @default(now())

  @@unique([appointmentId, serviceId])
  @@index([appointmentId, position])
  @@index([serviceId])
}

model AppointmentActualService {
  id                    String      @id @default(cuid())
  appointmentId         String
  serviceId             String
  appointment           Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service               Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceNameSnapshot   String
  actualDurationMinutes Int
  finalPrice            Decimal     @db.Decimal(12, 2)
  selectedColor         String?
  position              Int         @default(0)
  createdAt             DateTime    @default(now())

  @@unique([appointmentId, serviceId])
  @@index([appointmentId, position])
  @@index([serviceId])
}

model AppointmentPhoto {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  originalName  String
  imagePath     String      @unique
  thumbnailPath String      @unique
  width         Int
  height        Int
  sizeBytes     Int
  featuredAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
  @@index([featuredAt])
  @@index([createdAt])
}

model InstagramConnection {
  id                   String          @id @default(cuid())
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramUserId      String
  username             String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  lastSyncedAt         DateTime?
  lastError            String?
  posts                InstagramPost[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model InstagramPost {
  id              String              @id @default(cuid())
  connectionId    String
  connection      InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  remoteMediaId   String              @unique
  caption         String?
  mediaType       String
  permalink       String
  publishedAt     DateTime
  cachedImagePath String              @unique
  active          Boolean             @default(true)
  syncedAt        DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([active, publishedAt])
  @@index([connectionId, publishedAt])
}
