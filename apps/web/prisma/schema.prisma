generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF

  @@map("AccountRole")
}

enum MediaOwnerType {
  CUSTOMER_AVATAR
  APPOINTMENT_PHOTO
}

enum FinancialAccountType {
  CASH
  BANK
  CARD
  E_WALLET
  OTHER
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  OPENING_ADJUSTMENT
  APPOINTMENT_PAYMENT
  BILL_PAYMENT
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ExportJobStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum MediaStatus {
  STAGING
  PROCESSING
  READY
  FAILED
}

enum MediaVariantKind {
  AVATAR_SMALL
  AVATAR_LARGE
  THUMBNAIL
  MEDIUM
  LARGE
  PUBLIC
}

enum MediaJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GoogleCalendarConnectionStatus {
  CONNECTED
  PAUSED
}

enum GoogleCalendarSyncOperation {
  UPSERT
  DELETE
}

enum GoogleCalendarSyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum Locale {
  en
  fa
}

enum Theme {
  DARK
  LIGHT
  SYSTEM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  HISTORICAL
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
}

model User {
  id                           String                     @id @default(cuid())
  email                        String                     @unique
  name                         String
  passwordHash                 String?
  googleSubject                String?                    @unique
  role                         Role                       @default(STAFF)
  permissionOverrides          Json                       @default("{}")
  active                       Boolean                    @default(true)
  deletedAt                    DateTime?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  preferences                  UserPreference?
  sentInvitations              Invitation[]               @relation("InvitationSender")
  acceptedInvitations          Invitation[]               @relation("InvitationRecipient")
  auditEvents                  AuditLog[]                 @relation("AuditActor")
  connectedInstagram           InstagramConnection[]      @relation("InstagramConnector")
  connectedGoogleCalendars     GoogleCalendarConnection[] @relation("GoogleCalendarConnector")
  configuredGoogleCalendar     GoogleCalendarCredential[] @relation("GoogleCalendarCredentialConfigurer")
  notificationReceipts         NotificationReceipt[]
  recordedPayments             AppointmentPayment[]       @relation("PaymentRecorder")
  createdFinancialTransactions FinancialTransaction[]     @relation("FinancialTransactionCreator")
  updatedFinancialTransactions FinancialTransaction[]     @relation("FinancialTransactionUpdater")
  requestedExports             ExportJob[]                @relation("ExportRequester")
  approvedReviews              StudioReview[]             @relation("ReviewApprover")

  @@index([role, active])
  @@index([deletedAt])
}

model StudioSettings {
  id                     String   @id @default("studio")
  name                   String   @default("Manisa")
  storageQuotaBytes      BigInt   @default(10737418240)
  storageUsedBytes       BigInt   @default(0)
  storageReservedBytes   BigInt   @default(0)
  currency               String   @default("CAD") @db.VarChar(3)
  timezone               String   @default("America/Toronto")
  address                String?  @default("77 Finch Avenue East, Toronto, ON")
  instagramUrl           String?
  publicPhone            String?
  publicEmail            String?
  bookingUrl             String?
  studioTagline          String?
  studioBiography        String?
  financialRetentionDays Int      @default(2190)
  invoicePrefix          String   @default("INV")
  nextInvoiceNumber      Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Invitation {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  email               String
  role                Role      @default(STAFF)
  permissionOverrides Json      @default("{}")
  invitedById         String
  invitedBy           User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedById        String?
  acceptedBy          User?     @relation("InvitationRecipient", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt           DateTime
  acceptedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([email, expiresAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorSnapshot String
  action        String
  targetType    String
  targetId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model NotificationReceipt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  readAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, readAt])
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  locale            Locale   @default(en)
  theme             Theme    @default(DARK)
  mobileNavOrder    String   @default("report,calendar,gallery,settings")
  collectionViews   Json     @default("{}")
  collapsedSections Json     @default("{}")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("Settings")
}

model StudioReview {
  id           String       @id @default(cuid())
  reviewerName String
  rating       Int
  opinion      String
  language     Locale       @default(en)
  status       ReviewStatus @default(PENDING)
  approvedById String?
  approvedBy   User?        @relation("ReviewApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([approvedAt])
  @@index([deletedAt, createdAt])
}

model GoogleCalendarCredential {
  id                    String                     @id @default("google-calendar")
  clientId              String
  encryptedClientSecret String
  redirectUri           String
  configuredById        String
  configuredBy          User                       @relation("GoogleCalendarCredentialConfigurer", fields: [configuredById], references: [id], onDelete: Restrict)
  connections           GoogleCalendarConnection[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
}

model Customer {
  id                String        @id @default(cuid())
  referrerId        String?
  referrer          Customer?     @relation("CustomerReferrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals         Customer[]    @relation("CustomerReferrals")
  firstName         String
  lastName          String?
  displayName       String?
  phone             String?
  email             String?
  address           String?
  notes             String?
  preferredLanguage Locale        @default(en)
  active            Boolean       @default(true)
  deletedAt         DateTime?
  appointments      Appointment[]
  profilePhotos     MediaAsset[]  @relation("CustomerAvatar")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([firstName, lastName])
  @@index([phone])
  @@index([email])
  @@index([active])
  @@index([createdAt])
  @@index([referrerId])
  @@index([deletedAt])
}

model StudioCategory {
  id          String    @id @default(cuid())
  slug        String
  name        String
  description String?
  icon        String    @default("sparkles")
  accentColor String    @default("#4F8CFF") @db.VarChar(7)
  position    Int       @default(0)
  active      Boolean   @default(true)
  deletedAt   DateTime?
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug])
  @@index([active, position])
  @@index([deletedAt])
}

model Service {
  id                        String                     @id @default(cuid())
  name                      String
  description               String?
  defaultDurationMinutes    Int
  defaultPrice              Decimal                    @db.Decimal(12, 2)
  currency                  String                     @default("CAD") @db.VarChar(3)
  categoryId                String
  category                  StudioCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supportsColor             Boolean                    @default(false)
  active                    Boolean                    @default(true)
  deletedAt                 DateTime?
  appointments              Appointment[]
  appointmentServices       AppointmentService[]
  actualAppointmentServices AppointmentActualService[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([name])
  @@index([active])
  @@index([categoryId, active])
  @@index([deletedAt])
}

model Appointment {
  id                            String                     @id @default(cuid())
  customerId                    String
  serviceId                     String?
  customer                      Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service                       Service?                   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceLines                  AppointmentService[]
  actualServiceLines            AppointmentActualService[]
  photos                        MediaAsset[]
  serviceNameSnapshot           String
  startAt                       DateTime                   @db.Timestamptz(3)
  expectedDurationMinutes       Int
  actualDurationMinutes         Int?
  status                        AppointmentStatus          @default(SCHEDULED)
  expectedPrice                 Decimal                    @db.Decimal(12, 2)
  finalPrice                    Decimal?                   @db.Decimal(12, 2)
  currency                      String                     @default("CAD") @db.VarChar(3)
  paymentStatus                 PaymentStatus              @default(UNPAID)
  paymentReconciliationRequired Boolean                    @default(false)
  payments                      AppointmentPayment[]
  invoices                      CustomerInvoice[]
  notes                         String?
  completionNotes               String?
  importSourceId                String?
  calendarSyncError             String?
  completedAt                   DateTime?                  @db.Timestamptz(3)
  deletedAt                     DateTime?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt

  @@unique([importSourceId])
  @@index([startAt])
  @@index([customerId, startAt])
  @@index([serviceId, startAt])
  @@index([status, startAt])
  @@index([status, completedAt])
  @@index([paymentStatus])
  @@index([deletedAt])
}

model GoogleCalendarConnection {
  id                    String                         @id @default(cuid())
  credentialId          String                         @default("google-calendar")
  credential            GoogleCalendarCredential       @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  connectedById         String
  connectedBy           User                           @relation("GoogleCalendarConnector", fields: [connectedById], references: [id], onDelete: Restrict)
  googleAccountEmail    String
  calendarId            String                         @default("primary")
  calendarName          String                         @default("Primary calendar")
  primary               Boolean                        @default(false)
  encryptedRefreshToken String
  grantedScopes         String
  status                GoogleCalendarConnectionStatus @default(CONNECTED)
  lastSuccessfulSyncAt  DateTime?
  lastCheckedAt         DateTime?
  lastError             String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  events                GoogleCalendarEvent[]
  jobs                  GoogleCalendarSyncJob[]

  @@unique([googleAccountEmail, calendarId])
  @@index([status, updatedAt])
}

model GoogleCalendarEvent {
  id            String                   @id @default(cuid())
  connectionId  String
  connection    GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  appointmentId String
  googleEventId String
  etag          String?
  lastSyncedAt  DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([connectionId, appointmentId])
  @@unique([connectionId, googleEventId])
  @@index([lastSyncedAt])
}

model GoogleCalendarSyncJob {
  id            String                      @id @default(cuid())
  connectionId  String
  connection    GoogleCalendarConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  appointmentId String
  operation     GoogleCalendarSyncOperation
  googleEventId String?
  status        GoogleCalendarSyncStatus    @default(PENDING)
  attempts      Int                         @default(0)
  revision      Int                         @default(1)
  availableAt   DateTime                    @default(now())
  lockedAt      DateTime?
  lastError     String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@unique([connectionId, appointmentId])
  @@index([status, availableAt])
  @@index([connectionId, status])
}

model PaymentMethod {
  id               String               @id @default(cuid())
  name             String
  icon             String               @default("wallet")
  position         Int                  @default(0)
  active           Boolean              @default(true)
  deletedAt        DateTime?
  payments         AppointmentPayment[]
  defaultAccountId String?
  defaultAccount   FinancialAccount?    @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([name])
  @@index([active, position])
  @@index([deletedAt])
  @@index([defaultAccountId])
}

model AppointmentPayment {
  id                 String                @id @default(cuid())
  appointmentId      String
  appointment        Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  paymentMethodId    String?
  paymentMethod      PaymentMethod?        @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  methodNameSnapshot String
  amount             Decimal               @db.Decimal(12, 2)
  paidAt             DateTime              @default(now()) @db.Timestamptz(3)
  note               String?
  recordedById       String?
  recordedBy         User?                 @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  transactionId      String?               @unique
  transaction        FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  voidedAt           DateTime?
  voidReason         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([appointmentId, voidedAt])
  @@index([paymentMethodId, paidAt])
  @@index([paidAt])
  @@index([voidedAt])
}

model FinancialAccount {
  id                      String                 @id @default(cuid())
  name                    String
  type                    FinancialAccountType
  openingBalance          Decimal                @default(0) @db.Decimal(12, 2)
  openedAt                DateTime               @default(now()) @db.Timestamptz(3)
  active                  Boolean                @default(true)
  position                Int                    @default(0)
  deletedAt               DateTime?
  archivedAt              DateTime?
  purgeAt                 DateTime?
  sourceTransactions      FinancialTransaction[] @relation("FinancialTransactionSourceAccount")
  destinationTransactions FinancialTransaction[] @relation("FinancialTransactionDestinationAccount")
  paymentMethods          PaymentMethod[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([name])
  @@index([active, position])
  @@index([deletedAt, purgeAt])
}

model FinancialCategory {
  id                 String                  @id @default(cuid())
  name               String
  type               FinancialCategoryType
  active             Boolean                 @default(true)
  position           Int                     @default(0)
  deletedAt          DateTime?
  archivedAt         DateTime?
  purgeAt            DateTime?
  transactions       FinancialTransaction[]
  billLines          BillLine[]
  recurringTemplates RecurringBillTemplate[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([type, name])
  @@index([type, active, position])
  @@index([deletedAt, purgeAt])
}

model Vendor {
  id                 String                  @id @default(cuid())
  name               String
  email              String?
  phone              String?
  notes              String?
  active             Boolean                 @default(true)
  deletedAt          DateTime?
  archivedAt         DateTime?
  purgeAt            DateTime?
  transactions       FinancialTransaction[]
  bills              SupplierBill[]
  recurringTemplates RecurringBillTemplate[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([name])
  @@index([active, name])
  @@index([deletedAt, purgeAt])
}

model FinancialTransaction {
  id                      String                   @id @default(cuid())
  type                    FinancialTransactionType
  accountId               String
  account                 FinancialAccount         @relation("FinancialTransactionSourceAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccountId    String?
  destinationAccount      FinancialAccount?        @relation("FinancialTransactionDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  categoryId              String?
  category                FinancialCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId                String?
  vendor                  Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  billId                  String?
  bill                    SupplierBill?            @relation(fields: [billId], references: [id], onDelete: SetNull)
  accountNameSnapshot     String
  destinationNameSnapshot String?
  categoryNameSnapshot    String?
  vendorNameSnapshot      String?
  amount                  Decimal                  @db.Decimal(12, 2)
  currency                String                   @db.VarChar(3)
  occurredAt              DateTime                 @db.Timestamptz(3)
  description             String
  reference               String?
  appointmentPayment      AppointmentPayment?
  attachments             FinancialAttachment[]
  createdById             String?
  createdBy               User?                    @relation("FinancialTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById             String?
  updatedBy               User?                    @relation("FinancialTransactionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt               DateTime?
  archivedAt              DateTime?
  purgeAt                 DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([accountId, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([vendorId])
  @@index([deletedAt, purgeAt])
}

model SupplierBill {
  id                  String                 @id @default(cuid())
  vendorId            String?
  vendor              Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorNameSnapshot  String
  billNumber          String?
  issueDate           DateTime               @db.Timestamptz(3)
  dueDate             DateTime?              @db.Timestamptz(3)
  currency            String                 @db.VarChar(3)
  total               Decimal                @db.Decimal(12, 2)
  notes               String?
  draft               Boolean                @default(false)
  recurringTemplateId String?
  recurringTemplate   RecurringBillTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
  lines               BillLine[]
  payments            FinancialTransaction[]
  attachments         FinancialAttachment[]
  deletedAt           DateTime?
  archivedAt          DateTime?
  purgeAt             DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([issueDate])
  @@index([dueDate])
  @@index([vendorId])
  @@index([deletedAt, purgeAt])
}

model BillLine {
  id                   String             @id @default(cuid())
  billId               String
  bill                 SupplierBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryNameSnapshot String
  description          String
  amount               Decimal            @db.Decimal(12, 2)
  position             Int                @default(0)
}

model RecurringBillTemplate {
  id                   String              @id @default(cuid())
  vendorId             String?
  vendor               Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorNameSnapshot   String
  categoryId           String?
  category             FinancialCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryNameSnapshot String
  description          String
  amount               Decimal             @db.Decimal(12, 2)
  frequency            RecurrenceFrequency
  nextIssueDate        DateTime            @db.Timestamptz(3)
  dueAfterDays         Int                 @default(0)
  active               Boolean             @default(true)
  bills                SupplierBill[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([active, nextIssueDate])
}

model CustomerInvoice {
  id               String      @id @default(cuid())
  appointmentId    String
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  invoiceNumber    Int
  invoicePrefix    String
  revision         Int         @default(1)
  businessSnapshot Json
  customerSnapshot Json
  serviceSnapshot  Json
  amount           Decimal     @db.Decimal(12, 2)
  currency         String      @db.VarChar(3)
  issueDate        DateTime    @db.Timestamptz(3)
  dueDate          DateTime?   @db.Timestamptz(3)
  notes            String?
  voidedAt         DateTime?
  deletedAt        DateTime?
  archivedAt       DateTime?
  purgeAt          DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([invoiceNumber])
  @@unique([appointmentId, revision])
  @@index([issueDate])
  @@index([deletedAt, purgeAt])
}

model FinancialAttachment {
  id            String                @id @default(cuid())
  transactionId String?
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  billId        String?
  bill          SupplierBill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  originalName  String
  mimeType      String
  objectKey     String                @unique
  sizeBytes     Int
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())

  @@index([transactionId])
  @@index([billId])
  @@index([deletedAt])
}

model ExportJob {
  id            String          @id @default(cuid())
  requestedById String
  requestedBy   User            @relation("ExportRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  fromDate      DateTime        @db.Timestamptz(3)
  toDate        DateTime        @db.Timestamptz(3)
  status        ExportJobStatus @default(QUEUED)
  progress      Int             @default(0)
  objectKey     String?
  checksum      String?
  sizeBytes     Int?
  fileCount     Int?
  errorMessage  String?
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([expiresAt])
}

model AppointmentService {
  id                  String      @id @default(cuid())
  appointmentId       String
  serviceId           String?
  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service             Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceNameSnapshot String
  durationMinutes     Int
  price               Decimal     @db.Decimal(12, 2)
  selectedColor       String?
  position            Int         @default(0)
  createdAt           DateTime    @default(now())

  @@unique([appointmentId, serviceId])
  @@index([appointmentId, position])
  @@index([serviceId])
}

model AppointmentActualService {
  id                    String      @id @default(cuid())
  appointmentId         String
  serviceId             String?
  appointment           Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service               Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceNameSnapshot   String
  actualDurationMinutes Int
  finalPrice            Decimal     @db.Decimal(12, 2)
  selectedColor         String?
  position              Int         @default(0)
  createdAt             DateTime    @default(now())

  @@unique([appointmentId, serviceId])
  @@index([appointmentId, position])
  @@index([serviceId])
}

model MediaAsset {
  id            String               @id @default(cuid())
  ownerType     MediaOwnerType       @default(APPOINTMENT_PHOTO)
  customerId    String?
  customer      Customer?            @relation("CustomerAvatar", fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  originalName  String
  objectKey     String?              @unique
  imagePath     String?              @unique
  thumbnailPath String?              @unique
  width         Int
  height        Int
  sizeBytes     Int
  status        MediaStatus          @default(READY)
  errorMessage  String?
  featuredAt    DateTime?
  deletedAt     DateTime?
  variants      MediaVariant[]
  jobs          MediaProcessingJob[]
  createdAt     DateTime             @default(now())

  @@index([appointmentId, createdAt])
  @@index([customerId])
  @@index([featuredAt])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("AppointmentPhoto")
}

model MediaVariant {
  id        String           @id @default(cuid())
  assetId   String
  asset     MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      MediaVariantKind
  objectKey String           @unique
  width     Int
  height    Int
  sizeBytes Int
  format    String           @default("webp")
  createdAt DateTime         @default(now())

  @@unique([assetId, kind])
  @@index([assetId])
}

model MediaProcessingJob {
  id          String         @id @default(cuid())
  assetId     String
  asset       MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status      MediaJobStatus @default(PENDING)
  attempts    Int            @default(0)
  lastError   String?
  availableAt DateTime       @default(now())
  lockedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, availableAt])
}

model InstagramConnection {
  id                   String          @id @default(cuid())
  singletonKey         Int             @unique @default(1)
  connectedById        String?
  connectedBy          User?           @relation("InstagramConnector", fields: [connectedById], references: [id], onDelete: SetNull)
  instagramUserId      String
  username             String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  lastSyncedAt         DateTime?
  lastError            String?
  posts                InstagramPost[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model InstagramPost {
  id              String              @id @default(cuid())
  connectionId    String
  connection      InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  remoteMediaId   String
  caption         String?
  mediaType       String
  permalink       String
  publishedAt     DateTime
  cachedImagePath String              @unique
  active          Boolean             @default(true)
  syncedAt        DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([remoteMediaId])
  @@index([active, publishedAt])
  @@index([connectionId, publishedAt])
}
