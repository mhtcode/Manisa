generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum PlatformRole {
  ROOT_OWNER
  PLATFORM_ADMIN
}

enum BusinessRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum BusinessTemplate {
  BLANK
  NAIL_HAIR
}

enum InvitationKind {
  PLATFORM
  BUSINESS
}

enum MediaOwnerType {
  CUSTOMER_AVATAR
  APPOINTMENT_PHOTO
}

enum MediaStatus {
  STAGING
  PROCESSING
  READY
  FAILED
}

enum MediaVariantKind {
  AVATAR_SMALL
  AVATAR_LARGE
  THUMBNAIL
  MEDIUM
  LARGE
  PUBLIC
}

enum MediaJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum Locale {
  en
  fa
}

enum Theme {
  DARK
  LIGHT
  SYSTEM
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  HISTORICAL
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String?
  googleSubject       String?              @unique
  role                Role                 @default(ADMIN)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  preferences         UserPreference?
  platformAccess      PlatformAccess?
  memberships         BusinessMembership[]
  ownedBusinesses     Business[]            @relation("BusinessPrimaryOwner")
  sentInvitations     Invitation[]          @relation("InvitationSender")
  acceptedInvitations Invitation[]          @relation("InvitationRecipient")
  auditEvents         AuditLog[]             @relation("AuditActor")
  connectedInstagram InstagramConnection[]  @relation("InstagramConnector")
  notificationReceipts NotificationReceipt[]
  recordedPayments     AppointmentPayment[] @relation("PaymentRecorder")
}

model PlatformAccess {
  id                  String       @id @default(cuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                PlatformRole
  permissionOverrides Json         @default("{}")
  active              Boolean      @default(true)
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  @@index([role, active])
  @@index([deletedAt])
}

model Business {
  id                   String               @id @default(cuid())
  name                 String
  slug                 String               @unique
  template             BusinessTemplate     @default(BLANK)
  active               Boolean              @default(true)
  primaryOwnerId       String
  primaryOwner         User                 @relation("BusinessPrimaryOwner", fields: [primaryOwnerId], references: [id], onDelete: Restrict)
  storageQuotaBytes    BigInt                @default(10737418240)
  storageUsedBytes     BigInt                @default(0)
  storageReservedBytes BigInt                @default(0)
  deletedAt            DateTime?
  settings             BusinessSettings?
  memberships          BusinessMembership[]
  invitations          Invitation[]
  auditLogs             AuditLog[]
  customers             Customer[]
  categories            StudioCategory[]
  services              Service[]
  appointments          Appointment[]
  paymentMethods        PaymentMethod[]
  payments              AppointmentPayment[]
  appointmentServices   AppointmentService[]
  actualServices        AppointmentActualService[]
  mediaAssets           MediaAsset[]
  notificationReceipts  NotificationReceipt[]
  instagramConnection   InstagramConnection?
  instagramPosts        InstagramPost[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  @@index([active, deletedAt])
  @@index([primaryOwnerId])
}

model BusinessSettings {
  id          String   @id @default(cuid())
  businessId  String   @unique
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currency    String   @default("CAD") @db.VarChar(3)
  timezone    String   @default("America/Toronto")
  address     String?
  instagramUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessMembership {
  id                  String       @id @default(cuid())
  userId              String
  businessId          String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business            Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role                BusinessRole
  permissionOverrides Json         @default("{}")
  active              Boolean      @default(true)
  deletedAt           DateTime?
  preferences         MembershipPreference?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  @@unique([userId, businessId])
  @@index([businessId, role, active])
  @@index([userId, active])
  @@index([deletedAt])
}

model MembershipPreference {
  id                String             @id @default(cuid())
  membershipId      String             @unique
  membership        BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  mobileNavOrder    String             @default("report,calendar,gallery,settings")
  collectionViews   Json               @default("{}")
  collapsedSections Json               @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Invitation {
  id                  String          @id @default(cuid())
  tokenHash           String          @unique
  email               String
  kind                 InvitationKind
  platformRole         PlatformRole?
  businessId           String?
  business             Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessRole         BusinessRole?
  permissionOverrides  Json            @default("{}")
  invitedById          String
  invitedBy            User            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedById         String?
  acceptedBy           User?           @relation("InvitationRecipient", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime        @default(now())
  @@index([email, expiresAt])
  @@index([businessId, expiresAt])
}

model AuditLog {
  id             String    @id @default(cuid())
  actorId        String?
  actor          User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorSnapshot  String
  businessId     String?
  business       Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  elevated       Boolean   @default(false)
  action         String
  targetType     String
  targetId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model NotificationReceipt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key       String
  readAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, businessId, key])
  @@index([userId, businessId, readAt])
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  businessName      String   @default("Manisa")
  locale            Locale   @default(en)
  theme             Theme    @default(DARK)
  currency          String   @default("CAD") @db.VarChar(3)
  timezone          String   @default("America/Toronto")
  mobileNavOrder    String   @default("report,calendar,gallery,settings")
  collectionViews   Json     @default("{}")
  collapsedSections Json     @default("{}")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@map("Settings")
}

model Customer {
  id                String        @id @default(cuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  referrerId        String?
  referrer          Customer?     @relation("CustomerReferrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals         Customer[]    @relation("CustomerReferrals")
  firstName         String
  lastName          String?
  displayName       String?
  phone             String?
  email             String?
  address           String?
  notes             String?
  preferredLanguage Locale        @default(en)
  active            Boolean       @default(true)
  deletedAt         DateTime?
  appointments      Appointment[]
  profilePhotos     MediaAsset[]   @relation("CustomerAvatar")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([businessId, firstName, lastName])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, active])
  @@index([businessId, createdAt])
  @@index([businessId, referrerId])
  @@index([businessId, deletedAt])
}

model StudioCategory {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  icon        String    @default("sparkles")
  accentColor String    @default("#4F8CFF") @db.VarChar(7)
  position    Int       @default(0)
  active      Boolean   @default(true)
  deletedAt   DateTime?
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([businessId, slug])
  @@index([businessId, active, position])
  @@index([businessId, deletedAt])
}

model Service {
  id                        String                     @id @default(cuid())
  businessId                String
  business                  Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                      String
  description               String?
  defaultDurationMinutes    Int
  defaultPrice              Decimal                    @db.Decimal(12, 2)
  currency                  String                     @default("CAD") @db.VarChar(3)
  categoryId                String
  category                  StudioCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supportsColor             Boolean                    @default(false)
  active                    Boolean                    @default(true)
  deletedAt                 DateTime?
  appointments              Appointment[]
  appointmentServices       AppointmentService[]
  actualAppointmentServices AppointmentActualService[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([businessId, name])
  @@index([businessId, active])
  @@index([businessId, categoryId, active])
  @@index([businessId, deletedAt])
}

model Appointment {
  id                      String                     @id @default(cuid())
  businessId              String
  business                Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId              String
  serviceId               String?
  customer                Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service                 Service?                   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceLines            AppointmentService[]
  actualServiceLines      AppointmentActualService[]
  photos                  MediaAsset[]
  serviceNameSnapshot     String
  startAt                 DateTime                   @db.Timestamptz(3)
  expectedDurationMinutes Int
  actualDurationMinutes   Int?
  status                  AppointmentStatus          @default(SCHEDULED)
  expectedPrice           Decimal                    @db.Decimal(12, 2)
  finalPrice              Decimal?                   @db.Decimal(12, 2)
  currency                String                     @default("CAD") @db.VarChar(3)
  paymentStatus           PaymentStatus              @default(UNPAID)
  paymentReconciliationRequired Boolean               @default(false)
  payments                AppointmentPayment[]
  notes                   String?
  completionNotes         String?
  calendarEventId         String?
  calendarSyncError       String?
  completedAt             DateTime?                  @db.Timestamptz(3)
  deletedAt               DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@unique([businessId, calendarEventId])
  @@index([businessId, startAt])
  @@index([businessId, customerId, startAt])
  @@index([businessId, serviceId, startAt])
  @@index([businessId, status, startAt])
  @@index([businessId, status, completedAt])
  @@index([businessId, paymentStatus])
  @@index([businessId, deletedAt])
}

model PaymentMethod {
  id        String               @id @default(cuid())
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name      String
  icon      String               @default("wallet")
  position  Int                  @default(0)
  active    Boolean              @default(true)
  deletedAt DateTime?
  payments  AppointmentPayment[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([businessId, name])
  @@index([businessId, active, position])
  @@index([businessId, deletedAt])
}

model AppointmentPayment {
  id                 String         @id @default(cuid())
  businessId         String
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId      String
  appointment        Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  paymentMethodId    String?
  paymentMethod      PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  methodNameSnapshot String
  amount             Decimal        @db.Decimal(12, 2)
  paidAt             DateTime       @default(now()) @db.Timestamptz(3)
  note               String?
  recordedById       String?
  recordedBy         User?          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  voidedAt           DateTime?
  voidReason         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([businessId, appointmentId, voidedAt])
  @@index([businessId, paymentMethodId, paidAt])
  @@index([businessId, paidAt])
  @@index([businessId, voidedAt])
}

model AppointmentService {
  id                  String      @id @default(cuid())
  businessId          String
  business            Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId       String
  serviceId           String?
  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service             Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceNameSnapshot String
  durationMinutes     Int
  price               Decimal     @db.Decimal(12, 2)
  selectedColor       String?
  position            Int         @default(0)
  createdAt           DateTime    @default(now())

  @@unique([appointmentId, serviceId])
  @@index([appointmentId, position])
  @@index([serviceId])
}

model AppointmentActualService {
  id                    String      @id @default(cuid())
  businessId            String
  business              Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId         String
  serviceId             String?
  appointment           Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service               Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceNameSnapshot   String
  actualDurationMinutes Int
  finalPrice            Decimal     @db.Decimal(12, 2)
  selectedColor         String?
  position              Int         @default(0)
  createdAt             DateTime    @default(now())

  @@unique([appointmentId, serviceId])
  @@index([appointmentId, position])
  @@index([serviceId])
}

model MediaAsset {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerType     MediaOwnerType @default(APPOINTMENT_PHOTO)
  customerId    String?
  customer      Customer?   @relation("CustomerAvatar", fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  originalName  String
  objectKey     String?     @unique
  imagePath     String?     @unique
  thumbnailPath String?     @unique
  width         Int
  height        Int
  sizeBytes     Int
  status        MediaStatus @default(READY)
  errorMessage  String?
  featuredAt    DateTime?
  deletedAt     DateTime?
  variants      MediaVariant[]
  jobs          MediaProcessingJob[]
  createdAt     DateTime    @default(now())

  @@index([businessId, appointmentId, createdAt])
  @@index([businessId, customerId])
  @@index([businessId, featuredAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, deletedAt])
  @@map("AppointmentPhoto")
}

model MediaVariant {
  id        String           @id @default(cuid())
  assetId   String
  asset     MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      MediaVariantKind
  objectKey String           @unique
  width     Int
  height    Int
  sizeBytes Int
  format    String           @default("webp")
  createdAt DateTime         @default(now())
  @@unique([assetId, kind])
  @@index([assetId])
}

model MediaProcessingJob {
  id          String         @id @default(cuid())
  assetId     String
  asset       MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status      MediaJobStatus @default(PENDING)
  attempts    Int            @default(0)
  lastError   String?
  availableAt DateTime       @default(now())
  lockedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([status, availableAt])
}

model InstagramConnection {
  id                   String          @id @default(cuid())
  businessId           String          @unique
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectedById        String?
  connectedBy          User?           @relation("InstagramConnector", fields: [connectedById], references: [id], onDelete: SetNull)
  instagramUserId      String
  username             String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  lastSyncedAt         DateTime?
  lastError            String?
  posts                InstagramPost[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model InstagramPost {
  id              String              @id @default(cuid())
  businessId      String
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      InstagramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  remoteMediaId   String
  caption         String?
  mediaType       String
  permalink       String
  publishedAt     DateTime
  cachedImagePath String              @unique
  active          Boolean             @default(true)
  syncedAt        DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([businessId, remoteMediaId])
  @@index([businessId, active, publishedAt])
  @@index([businessId, connectionId, publishedAt])
}
