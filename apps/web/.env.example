# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://manisa:manisa@localhost:5432/manisa?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Use true only when the application is served over HTTPS.
SESSION_COOKIE_SECURE="false"

# Development seed administrator. Never use these example values in production.
SEED_ADMIN_EMAIL="admin@manisa.local"
SEED_ADMIN_PASSWORD="change-me-before-use"

# Public landing page business details. These values are safe to expose to browsers.
NEXT_PUBLIC_BUSINESS_ADDRESS="77 Finch Avenue East, Toronto, Ontario"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/nail_toronto_manisa/"

# Optional Instagram Professional integration. Requires a public HTTPS callback.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="https://your-domain.example/api/integrations/instagram/callback"
# Generate separately from AUTH_SECRET: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""

# Separate secret shared only with the hourly Trash cleanup worker.
TRASH_CLEANUP_SECRET="replace-with-at-least-32-random-characters"

# Optional Google Calendar integration. Manisa works without these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"
GOOGLE_AUTH_REDIRECT_URI="https://your-domain.example/api/auth/google/callback"
# Enable only while approving a new studio administrator account, then turn it off.
GOOGLE_AUTH_ALLOW_SIGNUP="false"

# Local photo storage. Docker Compose uses its persistent manisa_uploads volume.
UPLOADS_DIR=".data/uploads"
