# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://manisa:manisa@localhost:5432/manisa?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Use true only when the application is served over HTTPS.
SESSION_COOKIE_SECURE="false"

# Development seed administrator. Never use these example values in production.
SEED_ADMIN_EMAIL="admin@manisa.local"
SEED_ADMIN_PASSWORD="change-me-before-use"

# Optional Google Calendar integration. Manisa works without these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"
