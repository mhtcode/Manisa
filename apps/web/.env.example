# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://manisa:manisa@localhost:5432/manisa?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Use true only when the application is served over HTTPS.
SESSION_COOKIE_SECURE="false"

# Development seed administrator. Never use these example values in production.
SEED_ADMIN_EMAIL="admin@manisa.local"
SEED_ADMIN_PASSWORD="change-me-before-use"

# Public landing page business details. These values are safe to expose to browsers.
NEXT_PUBLIC_BUSINESS_ADDRESS="Toronto, Ontario"
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""

# Optional Google Calendar integration. Manisa works without these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"

# Local photo storage. Docker Compose uses its persistent manisa_uploads volume.
UPLOADS_DIR=".data/uploads"
